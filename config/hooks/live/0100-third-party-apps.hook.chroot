#!/bin/bash
set -euo pipefall
export DEBIAN_FRONTEND=noninteractive
cd /tmp

# Signal
curl -fsSL https://updates.signal.org/desktop/apt/keys.asc | gpg --dearmor > /usr/share/keyrings/signal-desktop-keyring.gpg
curl -fsSLo /etc/apt/sources.list.d/signal-desktop.sources https://updates.signal.org/static/desktop/apt/signal-desktop.sources

# Proton VPN
curl -fsSLo protonvpn-repo.deb https://repo.protonvpn.com/debian/dists/stable/main/binary-all/protonvpn-stable-release_1.0.10_all.deb
dpkg -i ./protonvpn-repo.deb

apt-get update && apt-get install -y signal-desktop protonvpn-gnome-desktop

# Bitwarden .deb (URL from memory)
curl -fsSLo bitwarden.deb "https://vault.bitwarden.com/download/?app=desktop&platform=linux&variant=deb"

# MarkText
curl -fsSLo marktext.deb https://github.com/marktext/marktext/releases/download/v0.23.0/marktext-linux-0.23.0.deb

apt-get install -y ./bitwarden.deb ./marktext.deb

rm -f /tmp/*.deb
apt-get clean